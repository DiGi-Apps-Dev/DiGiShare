# Copia questo file in .env e completalo. Il .env contiene segreti: non metterlo mai nel repository.

# Obbligatoria: 32 byte casuali. Si genera con:
#   openssl rand -base64 32 | tr '+/' '-_' | tr -d '='
# Persa questa chiave, i backup non si riaprono e l'Authenticator va riconfigurato. Tienine una copia al sicuro.
DIGISHARE_AUTH_KEY=

# 1 solo per creare il primo utente; poi 0 e ricrea il container (vedi README).
DIGISHARE_ALLOW_SETUP=1

# Fuso orario.
TZ=Europe/Rome

# Indirizzo pubblico con cui escono i link, per esempio https://digishare.tuodominio.it
INDIRIZZO_PUBBLICO=

# Nome del tuo proxy HTTPS nella rete Docker, se ne usi uno (vedi README).
PROXY_FIDATO=

# Spazio massimo per un file e margine da lasciare libero sul disco, in GB.
MASSIMO_GB=50
MARGINE_DISCO_GB=5

# Trascrizione e riassunto: Gemini ascolta l'audio e scrive chi dice cosa, Groq e' la riserva.
# Le chiavi si creano su https://aistudio.google.com/apikey e https://console.groq.com/keys
GEMINI_API_KEY=
GROQ_API_KEY=

# Riserve facoltative per capitoli e riassunti.
NVIDIA_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Email per avvisi di sicurezza, recupero password, backup e link personali (facoltativa, ma senza niente recupero password).
SECURITY_EMAIL_TO=
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_FROM=
SMTP_PASS=

# Filtro del rumore (facoltativo): vedi bin/LEGGIMI.txt
#DEEPFILTER=/opt/digishare-bin/deep-filter

# Riconoscimento della voce di chi registra (facoltativo): vedi voci/LEGGIMI.txt
#VOCE_URL=http://digishare-voce:8796

# Registrazioni Zoom (facoltativo): app Server-to-Server OAuth su marketplace.zoom.us, sola lettura.
# Scope: cloud_recording:read:list_user_recordings:admin e cloud_recording:read:list_recording_files:admin.
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_UTENTE=
